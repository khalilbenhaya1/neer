NODE_ENV=development
SAAS_HOST=127.0.0.1
SAAS_PORT=8788
SAAS_PUBLIC_ORIGIN=http://localhost:8788
SAAS_DATABASE_URL=postgres://neer_app:change-me@127.0.0.1:5432/neer_saas
SAAS_MIGRATION_DATABASE_URL=postgres://neer_migrator:change-me@127.0.0.1:5432/neer_saas
SAAS_CREDENTIAL_ENCRYPTION_KEYS={"1":"replace-with-32-byte-base64-key"}
SAAS_CREDENTIAL_ACTIVE_KEY_VERSION=1
SAAS_DATA_DIR=./var/saas-data
SAAS_SESSION_TTL_SECONDS=604800
SAAS_TRUST_PROXY=false
