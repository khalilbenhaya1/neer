{
  "$schema": "https://mintlify.com/docs.json",
  "name": "NEER",
  "description": "Cognitive AI Infrastructure",
  "logo": {
    "light": "/assets/neer-logo-header-light.png",
    "dark": "/assets/neer-logo-header-dark.png"
  },
  "favicon": "/assets/neer-favicon.png",
  "redirects": [
    {
      "source": "/getting-started/introduction",
      "destination": "/neer-documentation/getting-started/introduction"
    },
    {
      "source": "/getting-started/quickstart",
      "destination": "/neer-documentation/getting-started/quickstart"
    },
    {
      "source": "/getting-started/installation",
      "destination": "/neer-documentation/getting-started/installation"
    },
    {
      "source": "/getting-started/configuration",
      "destination": "/neer-documentation/getting-started/configuration"
    }
  ],
  "theme": "mint",
  "icons": {
    "library": "lucide"
  },
  "fonts": {
    "body": {
      "family": "Fragment Mono"
    },
    "heading": {
      "family": "DM Sans"
    }
  },
  "colors": {
    "primary": "#FF5A36",
    "dark": "#FF5A36",
    "light": "#FF8A6B"
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "dark": "min-dark",
        "light": "min-light"
      }
    }
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/neer/neer",
        "icon": "github"
      },
      {
        "label": "Releases",
        "href": "https://github.com/neer/neer/releases",
        "icon": "package"
      }
    ]
  },
  "navigation": {
    "groups": [
      {
        "group": "Introduction",
        "pages": [
          "neer-documentation/getting-started/introduction",
          "neer-documentation/getting-started/quickstart",
          "neer-documentation/getting-started/installation",
          "neer-documentation/getting-started/configuration"
        ]
      },
      {
        "group": "Core Concepts",
        "pages": [
          "neer-documentation/concepts/architecture",
          "neer-documentation/concepts/cognitive-core",
          "neer-documentation/concepts/agents",
          "neer-documentation/concepts/models",
          "neer-documentation/concepts/memory",
          "neer-documentation/concepts/gateway",
          "neer-documentation/concepts/skills-tools"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "neer-documentation/guides/creating-agents",
          "neer-documentation/guides/creating-skills",
          "neer-documentation/guides/ollama",
          "neer-documentation/guides/multimodal",
          "neer-documentation/guides/channels",
          "neer-documentation/guides/automation"
        ]
      },
      {
        "group": "Interface",
        "pages": [
          "neer-documentation/interface/dashboard",
          "neer-documentation/interface/cognitive-state",
          "neer-documentation/interface/monitoring"
        ]
      },
      {
        "group": "Security",
        "pages": [
          "neer-documentation/security/overview",
          "neer-documentation/security/gateway-security",
          "neer-documentation/security/permissions"
        ]
      },
      {
        "group": "Development",
        "pages": [
          "neer-documentation/development/setup",
          "neer-documentation/development/project-structure",
          "neer-documentation/development/testing",
          "neer-documentation/development/contributing"
        ]
      },
      {
        "group": "Roadmap",
        "pages": ["neer-documentation/roadmap/cognitive-roadmap"]
      }
    ]
  }
}
